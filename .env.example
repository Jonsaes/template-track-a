# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local al repo.
# En producción, estos valores van en las Environment Variables del proyecto de Vercel.
# RECUERDA: un proyecto de Supabase NUEVO por cada cliente — nunca compartido.

# --- Supabase (Settings → API del proyecto del cliente) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor — nunca exponer con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Crons ---
# generar con: openssl rand -hex 32
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
